{
  "name": "@c4studio/diagram-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Renderer-agnostic C4 diagram layer: layout, React Flow node/edge components and image export, driven by the graph JSON the Python side emits.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && vite build"
  },
  "dependencies": {
    "dagre": "^0.8.5",
    "html-to-image": "^1.11.13"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/node": "^18.19.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  }
}
