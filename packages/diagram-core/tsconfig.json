{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    // Explicit since TypeScript 7. TS 5 auto-included every `@types/*`
    // it could find by walking up from this file; TS 7 does not, and
    // `src/cli.ts` — the headless renderer entry point — lost `process`
    // and `Buffer`. Only `node` is installed here, so this narrows
    // nothing that was actually in use.
    "types": ["node"],

    "composite": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
