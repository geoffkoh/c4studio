{
  "name": "c4studio-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace @c4studio/diagram-core && npm run build --workspace c4studio-frontend",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
