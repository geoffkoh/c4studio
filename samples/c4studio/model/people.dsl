// Who uses c4studio. All of them work on one machine — the tool is
// local-first by design, with no server, no accounts and no sharing except
// through git.

architect = person "Software Architect" "Models a system in Structurizr DSL and reads the diagrams it produces."

developer = person "Developer" "Keeps the model honest alongside the code, usually in the same pull request."

reviewer = person "Reviewer" "Reads diagrams on a pull request or in a wiki, and never installs anything."
